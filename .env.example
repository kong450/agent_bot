# ==============================================================================
# AGENT BOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Telegram Bot Token (@BotFather orqali olinadi)
# Bitta bot: TELEGRAM_BOT_TOKEN=...
# Ikki bot:  TELEGRAM_BOT_TOKENS=tok1,tok2  (vergul bilan, bo'sh joysiz)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_BOT_TOKENS=token1,token2

# 2. Bepul AI API Kalitlari (Istalgan birini yoki bir nechtasini kiriting):
# - Google AI Studio (bepul): https://aistudio.google.com/
GEMINI_API_KEY=

# - Groq Cloud (O'ta tezkor, Llama 3.3 70B & DeepSeek R1, bepul): https://console.groq.com/
GROQ_API_KEY=

# - OpenRouter (DeepSeek V3, DeepSeek R1, bepul modellar markazi): https://openrouter.ai/
OPENROUTER_API_KEY=

# - OpenAI (ixtiyoriy): https://platform.openai.com/
OPENAI_API_KEY=

# - Anthropic Claude (asosiy miya, uzun ufqli agent ishlar): https://console.anthropic.com/
#   Model ID ni docs'dan tasdiqlang. Kalit bo'lmasa zanjir Groq'dan davom etadi.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# 2b. Model ID va endpointlar (defaultlar optimal; ID'ni provayder docs'dan tasdiqlang)
# GROQ_MODEL=openai/gpt-oss-20b
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# LOCAL_MODEL=qwen3:4b
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT_S=60

# 3. Xavfsizlik: Botdan foydalana oladigan Admin Telegram ID lari (bo'sh bo'lsa hammaga ochiq)
ALLOWED_TELEGRAM_IDS=

# 4. Tizim parametrlari
DEFAULT_LANGUAGE=uz
DEBUG_MODE=True
